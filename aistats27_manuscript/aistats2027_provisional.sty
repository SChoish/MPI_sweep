\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{aistats2027_provisional}[2026/08/29 Provisional AISTATS-like layout]

% This file reproduces the current AISTATS submission geometry for drafting.
% Replace it with the official AISTATS 2027 style file once released.
\RequirePackage[letterpaper,top=0.55in,bottom=0.60in,left=0.875in,right=0.875in]{geometry}
\RequirePackage{times}
\RequirePackage{fancyhdr}
\RequirePackage{etoolbox}
\RequirePackage{microtype}
\RequirePackage{titlesec}
\RequirePackage{caption}
\RequirePackage{xcolor}

\setlength{\columnsep}{0.25in}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.45em}
\setlength{\textfloatsep}{7pt plus 2pt minus 2pt}
\setlength{\floatsep}{6pt plus 2pt minus 2pt}
\setlength{\intextsep}{6pt plus 2pt minus 2pt}
\setlength{\abovedisplayskip}{5pt plus 2pt minus 3pt}
\setlength{\belowdisplayskip}{5pt plus 2pt minus 3pt}
\setlength{\abovedisplayshortskip}{2pt plus 1pt}
\setlength{\belowdisplayshortskip}{3pt plus 1pt minus 1pt}
\setlength{\footnotesep}{6pt}

\titleformat{\section}{\large\bfseries\raggedright}{\thesection}{0.5em}{\MakeUppercase}
\titlespacing*{\section}{0pt}{1.5ex plus .3ex minus .2ex}{0.8ex}
\titleformat{\subsection}{\normalsize\bfseries\raggedright}{\thesubsection}{0.5em}{}
\titlespacing*{\subsection}{0pt}{1.2ex plus .2ex minus .2ex}{0.5ex}
\titleformat{\subsubsection}{\normalsize\bfseries\raggedright}{\thesubsubsection}{0.5em}{}
\titlespacing*{\subsubsection}{0pt}{1.0ex plus .2ex minus .2ex}{0.35ex}

\captionsetup{font=small,labelfont=bf,skip=3pt}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0.4pt}
\newcommand{\paperrunningtitle}{MPI for Stable Offline Policy Refinement}
\newcommand{\paperrunningauthor}{Anonymous Authors}
\fancyhead[LE,RO]{\small\bfseries\paperrunningtitle}
\fancyhead[LO,RE]{\small\bfseries\paperrunningauthor}
\fancyfoot[C]{\thepage}
\setlength{\headheight}{13pt}

\makeatletter
\renewcommand{\maketitle}{%
  \twocolumn[{%
    \vspace*{-0.42in}
    \hrule height 4pt\vspace{0.18in}
    \begin{center}
      {\LARGE\bfseries \@title\par}
      \vspace{0.15in}
      {\large\bfseries \@author\par}
      \vspace{0.08in}
      {\normalsize \@date\par}
    \end{center}
    \vspace{0.14in}\hrule height 1pt\vspace{0.18in}
  }]%
}
\makeatother

\renewenvironment{abstract}{%
  \begin{center}\large\bfseries Abstract\end{center}
  \vspace{-0.4em}\begin{quote}\small
}{\end{quote}\vspace{0.2em}}

\newcommand{\aistatsnotice}{%
\begin{center}\footnotesize Provisional AISTATS 2027 manuscript.\end{center}}
